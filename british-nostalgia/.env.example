# Sanity CMS — primary content source (site renders from Sanity when project ID is set)
NEXT_PUBLIC_USE_SANITY=true
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-15
SANITY_API_READ_TOKEN=sanity_viewer_token_...

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Signed download access tokens (min 32 chars; generate with: openssl rand -hex 32)
DOWNLOAD_TOKEN_SECRET=your-random-32-char-string-or-longer

# Site URL (local dev only). On Netlify, leave unset — Netlify URL is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
