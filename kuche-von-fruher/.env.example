# Stripe webhook (account keys in repo-root .env.stripe)
# Run: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Copy the whsec_... secret into STRIPE_WEBHOOK_SECRET below
STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel Blob (for production PDF storage)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Random prefix for blob paths (set after running npm run upload-pdfs)
BLOB_PDF_SECRET_PREFIX=your-random-32-char-string

# Signed download access tokens (min 32 chars; generate with: openssl rand -hex 32)
DOWNLOAD_TOKEN_SECRET=your-random-32-char-string-or-longer

# Site URL (required for local redirects). Set to
# values are ignored in production so checkout cannot redirect to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS (public values; safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-15

# Server-only Sanity token for private dataset reads. Create a Viewer token in
# Sanity and set it locally/hosting; never expose it with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=sanity_viewer_token_...

# Editor token for PDF/content uploads (scripts/upload-pdfs-to-sanity-all-sites.ts)
SANITY_API_WRITE_TOKEN=
