# Shared Stripe account keys for all Bookforge landing sites.
# Copy to repo root: cp .env.stripe.example .env.stripe
# Used by Docker Compose (production) and merged at build time in docker/Dockerfile.
# STRIPE_WEBHOOK_SECRET stays in each site's .env (one webhook endpoint per domain).

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
